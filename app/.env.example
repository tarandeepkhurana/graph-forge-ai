# Copy to .env and fill in. Never commit .env.

# Session signing. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Supabase Postgres (use the connection-pooler URI, and note the +asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Neo4j (local docker, or an Aura URI)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Used for chat, quiz and the node "enhance" button -- not for extraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano          # chat, quiz, resolution adjudication

# Extraction builds the graph and is the quality-critical call
EXTRACTION_MODEL=openai
EXTRACTION_OPENAI_MODEL=gpt-5-mini

# Local development over http needs this false; MUST be true in production
COOKIE_SECURE=false
DEBUG=true
BASE_URL=http://localhost:8000
